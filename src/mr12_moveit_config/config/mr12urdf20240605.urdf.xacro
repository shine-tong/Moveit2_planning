<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mr12urdf20240605">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import mr12urdf20240605 urdf file -->
    <xacro:include filename="$(find mr12urdf20240605)/urdf/mr12urdf20240605.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="mr12urdf20240605.ros2_control.xacro" />


    <xacro:mr12urdf20240605_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
